[Unit]
Description=InstaUMI alignment review loopback backend
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/osmo-360-apriltag-pose
Environment=PYTHONPATH=%h/osmo-360-apriltag-pose/src
Environment=OMP_NUM_THREADS=1
Environment=OMP_THREAD_LIMIT=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=BLIS_NUM_THREADS=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=OPENCV_FOR_THREADS_NUM=1
Environment=OMP_DYNAMIC=FALSE
Environment=MKL_DYNAMIC=FALSE
ExecStart=%h/osmo-360-apriltag-pose/.venv/bin/python %h/osmo-360-apriltag-pose/bin/serve-alignment-review %h/current-robotics-data-2/umi_insta360/alignment-review-v1 --host 127.0.0.1 --port 7870 --state-root %h/review-state/alignment-review-v1
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=%h/review-state/alignment-review-v1
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TasksMax=24
MemoryMax=512M
LimitNOFILE=1024

[Install]
WantedBy=default.target
