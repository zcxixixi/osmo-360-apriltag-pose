[Unit]
Description=InstaUMI automation progress dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/osmo-360-apriltag-pose-cpu
Environment=PYTHONPATH=%h/osmo-360-apriltag-pose-cpu/src
ExecStart=%h/osmo-360-apriltag-pose-cpu/.venv/bin/python -m osmo360.pipeline.instaumi_auto_ui --data-root %h/current-robotics-data-2/total_annotation/umi_insta360 --host 0.0.0.0 --port 7871
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=%h/current-robotics-data-2/total_annotation/umi_insta360
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=default.target
