[Unit]
Description=Authenticated InstaUMI alignment review gateway
Requires=osmo-alignment-review-backend.service
After=osmo-alignment-review-backend.service

[Service]
Type=simple
WorkingDirectory=%h/osmo-360-apriltag-pose-cpu
Environment=PYTHONPATH=%h/osmo-360-apriltag-pose-cpu/src
ExecStart=%h/osmo-360-apriltag-pose-cpu/.venv/bin/python -m tools.serve_review_gateway --host 0.0.0.0 --port 7869 --backend-host 127.0.0.1 --backend-port 7870 --public-origin http://192.168.111.62:7869 --token-file %h/.config/osmo360/alignment-review-token --max-workers 16
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=%h/.config/osmo360/alignment-review-token
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TasksMax=24
MemoryMax=192M
LimitNOFILE=1024

[Install]
WantedBy=default.target
